# ==============================================================================
# DocuSage: Enterprise Document Intelligence Agent (RAG) Environment Config
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration (PostgreSQL + pgvector)
# For local Docker: postgresql+asyncpg://docusage:docusage_secret@localhost:5432/docusage_db
# For Supabase/Neon: postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://docusage:docusage_secret@localhost:5432/docusage_db

# Security & JWT Authentication
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Provider Selection
# Embedding Provider: 'local' (offline sentence-transformers all-MiniLM-L6-v2) or 'gemini'
EMBEDDING_PROVIDER=local

# LLM Provider: 'gemini', 'groq', or 'openrouter'
LLM_PROVIDER=gemini

# Provider Credentials
# Gemini API Key (get free from https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (get free from https://console.groq.com/)
GROQ_API_KEY=

# OpenRouter API Key (get free from https://openrouter.ai/)
OPENROUTER_API_KEY=

# Provider Model Overrides (Optional defaults apply)
# Gemini: gemini-1.5-flash, gemini-2.0-flash
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# OpenRouter: meta-llama/llama-3.2-3b-instruct:free
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding Vector Dimension
# 384 for all-MiniLM-L6-v2, 768 for text-embedding-004
EMBEDDING_DIMENSION=384

# Dual-Gate Abstention & Retrieval Parameters
RETRIEVAL_SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Confidence heuristic bands (composite = 0.7*top1 + 0.3*mean(top-k); heuristic, NOT calibrated probability)
CONFIDENCE_HIGH_THRESHOLD=0.80

# Quota Caps (Per User)
MAX_DOCS_PER_USER=20
MAX_FILE_SIZE_MB=25
MAX_PAGES_PER_DOC=150
